          return { H, limbRadius, limbX, limbY }
        }

        function getBezierPoint(u, p0, cp1, cp2, p3) {
          const term0 = Math.pow(1 - u, 3)
          const term1 = 3 * Math.pow(1 - u, 2) * u
          const term2 = 3 * (1 - u) * Math.pow(u, 2)
          const term3 = Math.pow(u, 3)
          
          return {
            x: term0 * p0.x + term1 * cp1.x + term2 * cp2.x + term3 * p3.x,
            y: term0 * p0.y + term1 * cp1.y + term2 * cp2.y + term3 * p3.y
