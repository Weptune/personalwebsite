---
interface Props {
  postId: string
}

const { postId } = Astro.props
---

<section
  class="gothic-panel fade-in-up-soft mt-12 overflow-hidden"
  data-post-feedback
  data-post-id={postId}
  aria-label="Post comments and likes"
>
  <div class="p-6">
    <!-- Likes Bar -->
    <div class="flex items-center justify-between gap-4 pb-6 border-b border-border/60">
      <div class="flex items-center gap-3">
        <button
          type="button"
          id={`like-btn-${postId.replace(/[^a-zA-Z0-9_-]/g, '-')}`}
          data-like-btn
          class="group flex items-center gap-2 rounded-full border border-border/80 bg-background/50 px-4 py-2 text-sm font-medium text-foreground transition-all duration-300 hover:border-red-500/50 hover:bg-red-500/10 focus:outline-none focus:ring-1 focus:ring-red-500/50"
          aria-label="Like this piece"
        >
          <svg
            data-heart-icon
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground transition-all duration-300 group-hover:scale-110 group-hover:text-red-500"
          >
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
          </svg>
          <span data-like-text class="font-serif italic">Like</span>
          <span
            data-like-count
            class="ml-1 rounded-full bg-muted/60 px-2 py-0.5 font-mono text-xs text-muted-foreground"
          >
            0
          </span>
        </button>
        <span class="text-xs text-muted-foreground font-serif italic hidden sm:inline">
          Enjoyed this piece? Leave a heart.
        </span>
      </div>
    </div>

    <!-- Comments Section -->
    <div class="pt-6">
      <h3 class="text-lg font-serif italic text-foreground mb-1">
        Comments
      </h3>
      <p class="text-xs text-muted-foreground font-serif italic mb-5">
        Leave a comment. Pick a name. It stays.
      </p>

      <form data-comment-form class="flex flex-col gap-4">
        <div>
          <label class="text-muted-foreground mb-1.5 block text-xs font-medium uppercase tracking-wider">
            Username
          </label>
          <input
            name="username"
            type="text"
            maxlength="64"
            placeholder="anonymous"
            class="border-border bg-background/50 text-foreground w-full rounded border px-3 py-2 text-sm outline-none transition-colors focus:ring-1 focus:ring-primary/50"
          />
        </div>
        <div>
          <label class="text-muted-foreground mb-1.5 block text-xs font-medium uppercase tracking-wider">
            Comment
          </label>
          <textarea
            name="comment"
            required
            rows="3"
            maxlength="500"
            placeholder="Say something about this piece..."
            class="border-border bg-background/50 text-foreground w-full resize-none rounded border px-3 py-2 text-sm outline-none transition-colors focus:ring-1 focus:ring-primary/50"
          ></textarea>
        </div>
        <button
          type="submit"
          class="border-border text-foreground hover:bg-muted/50 w-fit rounded border px-4 py-2 font-serif italic text-sm transition-colors cursor-pointer"
        >
          Post Comment
        </button>
      </form>

      <p data-comment-message class="text-muted-foreground mt-3 text-sm" role="status" aria-live="polite" hidden></p>

      <!-- Comment Entries List -->
      <div class="mt-8 flex flex-col gap-y-4">
        <h4 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">
          Discussion
        </h4>
        <div data-comments-list class="flex flex-col gap-3">
          <p class="text-muted-foreground text-sm font-serif italic">Loading comments...</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined

  interface CommentEntry {
    id: string
    username: string
    comment: string
    created_at: string
  }

  function formatDate(iso: string) {
    try {
      const d = new Date(iso)
      return d.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    } catch {
      return iso
    }
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div')
    div.textContent = str
    return div.innerHTML
  }

  function initPostFeedback(container: HTMLElement) {
    const rawPostId = container.dataset.postId
    if (!rawPostId) return
    const postId: string = rawPostId

    const likeBtn = container.querySelector('[data-like-btn]') as HTMLButtonElement | null
    const heartIcon = container.querySelector('[data-heart-icon]') as SVGElement | null
    const likeCountEl = container.querySelector('[data-like-count]') as HTMLElement | null
    const likeTextEl = container.querySelector('[data-like-text]') as HTMLElement | null

    const form = container.querySelector('[data-comment-form]') as HTMLFormElement | null
    const messageEl = container.querySelector('[data-comment-message]') as HTMLElement | null
    const commentsListEl = container.querySelector('[data-comments-list]') as HTMLElement | null
    const usernameInput = form?.querySelector('input[name="username"]') as HTMLInputElement | null
    const commentTextarea = form?.querySelector('textarea[name="comment"]') as HTMLTextAreaElement | null

    const LIKE_STORAGE_KEY = `pf_like_${postId}`
    const USER_HANDLE_KEY = 'pf_saved_username'
    const LOCAL_COMMENTS_KEY = `pf_comments_${postId}`
    const LOCAL_LIKES_KEY = `pf_likes_count_${postId}`

    // Prefill username if remembered
    if (usernameInput) {
      try {
        const savedHandle = localStorage.getItem(USER_HANDLE_KEY)
        if (savedHandle) {
          usernameInput.value = savedHandle
        }
      } catch {}
    }

    // --- LIKES SYSTEM ---
    let currentLikes = 0
    let isLiked = false
    let savedLikeId: string | null = null

    try {
      const storedLike = localStorage.getItem(LIKE_STORAGE_KEY)
      if (storedLike) {
        const parsed = JSON.parse(storedLike)
        isLiked = Boolean(parsed.liked)
        savedLikeId = parsed.id || null
      }
    } catch {}

    function updateLikeUI() {
      if (likeCountEl) likeCountEl.textContent = String(currentLikes)
      if (likeTextEl) likeTextEl.textContent = isLiked ? 'Liked' : 'Like'

      if (heartIcon && likeBtn) {
        if (isLiked) {
          heartIcon.setAttribute('fill', 'oklch(0.65 0.22 15)')
          heartIcon.setAttribute('stroke', 'oklch(0.65 0.22 15)')
          heartIcon.classList.remove('text-muted-foreground')
          heartIcon.classList.add('text-red-500', 'scale-110')
          likeBtn.classList.add('border-red-500/40', 'bg-red-500/10')
        } else {
          heartIcon.setAttribute('fill', 'none')
          heartIcon.setAttribute('stroke', 'currentColor')
          heartIcon.classList.remove('text-red-500', 'scale-110')
          heartIcon.classList.add('text-muted-foreground')
          likeBtn.classList.remove('border-red-500/40', 'bg-red-500/10')
        }
      }
    }

    async function fetchLikes() {
      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        // Fallback to local count if Supabase not configured
        try {
          currentLikes = parseInt(localStorage.getItem(LOCAL_LIKES_KEY) || '0', 10)
        } catch {
          currentLikes = 0
        }
        updateLikeUI()
        return
      }

      try {
        const res = await fetch(
          `${SUPABASE_URL}/rest/v1/post_likes?post_id=eq.${encodeURIComponent(postId)}&select=id`,
          {
            headers: {
              apikey: SUPABASE_ANON_KEY,
              Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            },
          }
        )
        if (res.ok) {
          const rows = await res.json()
          currentLikes = Array.isArray(rows) ? rows.length : 0
        } else {
          throw new Error('Fetch failed')
        }
      } catch {
        try {
          currentLikes = parseInt(localStorage.getItem(LOCAL_LIKES_KEY) || '0', 10)
        } catch {}
      }
      updateLikeUI()
    }

    async function toggleLike() {
      const prevLiked = isLiked
      const prevCount = currentLikes

      // Optimistic update
      isLiked = !prevLiked
      currentLikes = isLiked ? currentLikes + 1 : Math.max(0, currentLikes - 1)
      updateLikeUI()

      // Pulse animation trigger
      if (heartIcon) {
        heartIcon.classList.add('scale-125')
        setTimeout(() => heartIcon.classList.remove('scale-125'), 200)
      }

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        try {
          localStorage.setItem(LOCAL_LIKES_KEY, String(currentLikes))
          localStorage.setItem(LIKE_STORAGE_KEY, JSON.stringify({ liked: isLiked, id: 'local' }))
        } catch {}
        return
      }

      try {
        if (isLiked) {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/post_likes`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: SUPABASE_ANON_KEY,
              Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
              Prefer: 'return=representation',
            },
            body: JSON.stringify({ post_id: postId }),
          })

          if (res.ok) {
            const data = await res.json()
            if (Array.isArray(data) && data[0]?.id) {
              savedLikeId = data[0].id
              localStorage.setItem(LIKE_STORAGE_KEY, JSON.stringify({ liked: true, id: savedLikeId }))
            }
          } else {
            throw new Error('Insert like failed')
          }
        } else {
          // Unlike
          let deleteUrl = `${SUPABASE_URL}/rest/v1/post_likes?post_id=eq.${encodeURIComponent(postId)}`
          if (savedLikeId) {
            deleteUrl += `&id=eq.${savedLikeId}`
          }

          const res = await fetch(deleteUrl, {
            method: 'DELETE',
            headers: {
              apikey: SUPABASE_ANON_KEY,
              Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            },
          })

          if (res.ok) {
            savedLikeId = null
            localStorage.removeItem(LIKE_STORAGE_KEY)
          } else {
            throw new Error('Delete like failed')
          }
        }
      } catch {
        // Rollback optimistic state if request fails
        isLiked = prevLiked
        currentLikes = prevCount
        updateLikeUI()
      }
    }

    if (likeBtn) {
      likeBtn.onclick = (e) => {
        e.preventDefault()
        toggleLike()
      }
    }

    // --- COMMENTS SYSTEM ---
    async function fetchComments(): Promise<CommentEntry[]> {
      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        try {
          const raw = localStorage.getItem(LOCAL_COMMENTS_KEY)
          return raw ? JSON.parse(raw) : []
        } catch {
          return []
        }
      }

      try {
        const res = await fetch(
          `${SUPABASE_URL}/rest/v1/post_comments?post_id=eq.${encodeURIComponent(postId)}&select=id,username,comment,created_at&order=created_at.desc`,
          {
            headers: {
              apikey: SUPABASE_ANON_KEY,
              Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            },
          }
        )
        if (!res.ok) throw new Error('Fetch comments failed')
        return await res.json()
      } catch {
        try {
          const raw = localStorage.getItem(LOCAL_COMMENTS_KEY)
          return raw ? JSON.parse(raw) : []
        } catch {
          return []
        }
      }
    }

    function renderComments(entries: CommentEntry[]) {
      if (!commentsListEl) return
      if (entries.length === 0) {
        commentsListEl.innerHTML =
          '<p class="text-muted-foreground text-sm font-serif italic">No comments yet. Be the first to leave a note.</p>'
        return
      }

      commentsListEl.innerHTML = entries
        .map(
          (e) => `
        <div class="gothic-panel p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
            <span class="font-medium text-foreground">${escapeHtml(e.username || 'anonymous')}</span>
            <span class="text-muted-foreground text-xs font-serif italic">${formatDate(e.created_at)}</span>
          </div>
          <p class="text-muted-foreground mt-2 whitespace-pre-wrap text-sm leading-relaxed">${escapeHtml(e.comment)}</p>
        </div>
      `
        )
        .join('')
    }

    async function loadComments() {
      const comments = await fetchComments()
      renderComments(comments)
    }

    if (form) {
      form.onsubmit = async (e) => {
        e.preventDefault()
        const username = usernameInput?.value.trim() || 'anonymous'
        const comment = commentTextarea?.value.trim()
        if (!comment) return

        // Remember handle
        try {
          if (username && username !== 'anonymous') {
            localStorage.setItem(USER_HANDLE_KEY, username)
          }
        } catch {}

        if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
          // Local storage fallback if Supabase not configured
          const newEntry: CommentEntry = {
            id: String(Date.now()),
            username,
            comment,
            created_at: new Date().toISOString(),
          }
          try {
            const existing = await fetchComments()
            const updated = [newEntry, ...existing]
            localStorage.setItem(LOCAL_COMMENTS_KEY, JSON.stringify(updated))
            renderComments(updated)
            if (messageEl) {
              messageEl.textContent = 'Thanks. Your comment is posted locally (Supabase keys not configured).'
              messageEl.hidden = false
            }
            if (commentTextarea) commentTextarea.value = ''
          } catch {}
          return
        }

        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/post_comments`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: SUPABASE_ANON_KEY,
              Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
              Prefer: 'return=representation',
            },
            body: JSON.stringify({ post_id: postId, username, comment }),
          })

          if (!res.ok) {
            const err = await res.text()
            throw new Error(err)
          }

          if (messageEl) {
            messageEl.textContent = 'Thanks. Your comment is posted.'
            messageEl.hidden = false
            setTimeout(() => {
              messageEl.hidden = true
            }, 5000)
          }

          if (commentTextarea) commentTextarea.value = ''
          loadComments()
        } catch (err) {
          if (messageEl) {
            messageEl.textContent = 'Something went wrong while posting your comment. Try again.'
            messageEl.hidden = false
          }
        }
      }
    }

    // Initial load
    fetchLikes()
    loadComments()
  }

  function initAllPostFeedback() {
    const containers = document.querySelectorAll('[data-post-feedback]')
    containers.forEach((container) => {
      initPostFeedback(container as HTMLElement)
    })
  }

  initAllPostFeedback()
  document.addEventListener('astro:page-load', initAllPostFeedback)
</script>
