---
import { Separator } from '@/components/ui/separator'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  getMathsCombinedReadingTime,
  getMathsSubpostCount,
  getResearchCombinedReadingTime,
  getResearchSubpostCount,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'thoughts'> | CollectionEntry<'maths'> | CollectionEntry<'research'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const isThoughts = entry.collection === 'thoughts'
const isMaths = entry.collection === 'maths'

const readTime = isThoughts
  ? await getCombinedReadingTime(entry.id)
  : isMaths
    ? await getMathsCombinedReadingTime(entry.id)
    : await getResearchCombinedReadingTime(entry.id)

const subpostCount = !isSubpost(entry.id)
  ? (isThoughts
      ? await getSubpostCount(entry.id)
      : isMaths
        ? await getMathsSubpostCount(entry.id)
        : await getResearchSubpostCount(entry.id))
  : 0
---

<div
  class="gothic-panel p-4 transition-all duration-500 ease-out hover:-translate-y-1 flex flex-col gap-3"
>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class="group flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="w-full sm:max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover rounded-md"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-2 text-lg font-medium tracking-wide normal-case group-hover:text-accent transition-colors">
        {entry.data.title}
      </h3>

      <div
        class="text-muted-foreground flex flex-wrap items-center gap-x-2 text-xs"
      >
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent/80 font-medium">
          {entry.collection}
        </span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{readTime}</span>

        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>
    </div>
  </Link>

  {
    entry.data.tags && entry.data.tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-border/25">
        <Icon name="lucide:tags" class="size-3 text-muted-foreground/60 mr-0.5 shrink-0" />
        {entry.data.tags.map((tag: string) => (
          <Link
            href={`/tags/${tag}`}
            class="inline-flex items-center gap-0.5 text-[11px] font-mono px-2 py-0.5 rounded-full border border-border/40 bg-secondary/30 text-muted-foreground hover:text-foreground hover:border-accent/50 hover:bg-secondary/60 transition-all duration-200"
          >
            <span class="text-accent/80 font-mono">#</span>
            {tag}
          </Link>
        ))}
      </div>
    )
  }
</div>