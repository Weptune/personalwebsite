---
import Link from '@/components/Link.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'
---

<div class="header-wrapper">
  <div class="header-container">
    <Link href="/" class="header-logo">
      <Image src={logo} alt="Logo" class="size-5 shrink-0 sm:size-6" />
      <span class="hidden truncate text-lg leading-none font-medium min-[400px]:block">
        {SITE.title}
      </span>
    </Link>
    <nav class="header-nav">
      {
        NAV_LINKS.map((item) => (
          <Link
            href={item.href}
            class="header-link text-foreground/60 hover:text-foreground transition-colors"
          >
            {item.label}
          </Link>
        ))
      }
    </nav>
  </div>
</div>

<style>
  .header-wrapper {
    width: 100%;
  }

  .header-container {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 0;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    white-space: nowrap;
    overflow-x: auto;
    flex-grow: 1;
    min-width: 0;
    justify-content: flex-start;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .header-nav::-webkit-scrollbar {
    display: none;
  }

  .header-link {
    display: inline-block;
    flex-shrink: 0;
  }

  /* Desktop: center the entire navigation bar (logo + pages) together as one unified unit */
  @media (min-width: 840px) {
    .header-container {
      justify-content: center;
      gap: 1.75rem;
    }

    .header-nav {
      flex-grow: 0;
      overflow-x: visible;
      gap: 1.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.14em;
    }
  }

  @media (min-width: 1080px) {
    .header-container {
      gap: 2rem;
    }

    .header-nav {
      gap: 1.5rem;
      font-size: 0.875rem;
      letter-spacing: 0.16em;
    }
  }
</style>
