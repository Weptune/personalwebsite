---
import Link from '@/components/Link.astro'
import { ICON_MAP, NAV_LINKS, SITE, SOCIAL_LINKS } from '@/consts'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'

const currentPath = Astro.url.pathname

function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath.startsWith(href)
}

const NAV_CARDS = [
  { href: '/thoughts', label: 'thoughts', icon: 'lucide:library-big', hint: 'political and casual' },
  { href: '/maths', label: 'maths', icon: 'lucide:binary', hint: 'problems/topics i enjoy' },
  { href: '/research', label: 'research', icon: 'lucide:flask-conical', hint: 'write ups and papers' },
  { href: '/projects', label: 'projects', icon: 'lucide:folder-kanban', hint: 'code & experiments' },
  { href: '/albums', label: 'album reviews', icon: 'lucide:disc', hint: 'music archive' },
  { href: '/movies', label: 'movie reviews', icon: 'lucide:film', hint: 'cinema ratings' },
  { href: '/about', label: 'about me', icon: 'lucide:user', hint: 'get to know me ^^' },
  { href: '/guestbook', label: 'guestbook', icon: 'lucide:message-square', hint: 'leave a note' },
]
---

<div class="header-wrapper" id="header-wrapper">
  <div class="header-container">
    <Link href="/" class="header-logo">
      <Image src={logo} alt="Logo" class="size-5 shrink-0 sm:size-6" />
      <span class="truncate text-lg leading-none font-medium">
        {SITE.title}
      </span>
    </Link>

    <!-- Desktop nav (hidden on mobile, visible on >= 840px) -->
    <nav class="header-nav" aria-label="Main navigation">
      {
        NAV_LINKS.map((item) => {
          const active = isActive(item.href)
          return (
            <Link
              href={item.href}
              class:list={[
                'header-link transition-colors',
                active
                  ? 'text-foreground font-medium underline underline-offset-4 decoration-primary/60'
                  : 'text-foreground/60 hover:text-foreground',
              ]}
            >
              {item.label}
            </Link>
          )
        })
      }
    </nav>

    <!-- Mobile menu toggle button (visible on mobile, hidden on >= 840px) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="mobile-menu-btn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
    >
      <Icon name="lucide:menu" class="size-3.5 menu-icon-open" />
      <Icon name="lucide:x" class="size-3.5 menu-icon-close hidden" />
      <span class="mobile-menu-btn-text">menu</span>
    </button>
  </div>

  <!-- Mobile backdrop (covers entire screen behind drawer) -->
  <div
    id="mobile-menu-backdrop"
    class="mobile-menu-backdrop min-[840px]:hidden hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile drawer panel (fits content naturally without empty trailing void) -->
  <div
    id="mobile-menu-drawer"
    class="mobile-menu-drawer"
    role="dialog"
    aria-label="Navigation menu"
    aria-modal="true"
  >
    <div class="mobile-menu-content">
      <div class="flex items-center justify-between mb-2.5 px-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/70">
          navigation
        </span>
        <span class="text-[10px] font-mono text-muted-foreground/40">
          {NAV_CARDS.length} destinations
        </span>
      </div>

      <nav class="grid grid-cols-2 gap-2" aria-label="Mobile navigation">
        {
          NAV_CARDS.map((item) => {
            const active = isActive(item.href)
            return (
              <Link
                href={item.href}
                class:list={[
                  'mobile-nav-card group relative flex flex-col justify-between p-3 rounded-xl border transition-all duration-200',
                  active
                    ? 'border-primary/60 bg-primary/15 text-foreground ring-1 ring-primary/40 shadow-sm'
                    : 'border-white/10 bg-white/[0.03] hover:bg-white/[0.08] hover:border-white/20 text-foreground/80 hover:text-foreground',
                ]}
              >
                <div class="flex items-center justify-between mb-2">
                  <div
                    class:list={[
                      'flex size-7 items-center justify-center rounded-lg border transition-colors',
                      active
                        ? 'border-primary/40 bg-primary/20 text-primary'
                        : 'border-white/10 bg-white/[0.04] text-muted-foreground group-hover:text-primary group-hover:border-primary/30',
                    ]}
                  >
                    <Icon name={item.icon} class="size-3.5" />
                  </div>
                  {active ? (
                    <span class="inline-flex items-center gap-1 text-[9px] font-mono text-primary uppercase tracking-wider font-semibold">
                      <span class="size-1.5 rounded-full bg-primary animate-pulse" />
                      here
                    </span>
                  ) : (
                    <Icon
                      name="lucide:arrow-up-right"
                      class="size-3 text-muted-foreground/30 group-hover:text-foreground/70 transition-colors"
                    />
                  )}
                </div>
                <div>
                  <div class="font-medium text-xs tracking-wide lowercase group-hover:text-primary transition-colors">
                    {item.label}
                  </div>
                  <div class="text-[10px] text-muted-foreground font-mono mt-0.5">
                    {item.hint}
                  </div>
                </div>
              </Link>
            )
          })
        }
      </nav>

      <!-- Social links bar -->
      <div class="mt-3 pt-2.5 border-t border-white/10 flex items-center justify-between px-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/70">
          connect
        </span>
        <div class="flex items-center gap-1.5">
          {
            SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex size-7 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-muted-foreground hover:text-foreground hover:border-primary/40 hover:bg-white/[0.08] transition-all"
              >
                <Icon name={ICON_MAP[social.label]} class="size-3.5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .header-wrapper {
    position: relative;
    width: 100%;
    transition: background-color 0.2s ease;
  }

  /* When mobile menu is open, make the top bar solidly opaque */
  .header-wrapper.is-open {
    background-color: var(--background, #08090e) !important;
  }

  .header-container {
    position: relative;
    z-index: 60;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 0;
  }

  /* Desktop nav is hidden on mobile (< 840px) */
  .header-nav {
    display: none;
  }

  .header-link {
    display: inline-block;
    flex-shrink: 0;
  }

  /* Mobile menu button (< 840px) */
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .mobile-menu-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--color-border);
  }

  /* Dynamic theme accent styling for the active close button */
  .mobile-menu-btn.is-active {
    border-color: var(--primary);
    background-color: color-mix(in oklch, var(--primary) 15%, transparent);
    color: var(--primary);
    box-shadow: 0 0 14px -2px color-mix(in oklch, var(--primary) 35%, transparent);
  }

  /* Mobile backdrop (dimmed overlay over page) */
  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .mobile-menu-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile drawer: Natural height wrapping content cleanly */
  .mobile-menu-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 54px);
    background-color: var(--background, #08090e);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.85);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.18s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    touch-action: pan-y;
    z-index: 50;
  }

  .mobile-menu-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-content {
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    padding: 0.75rem 1rem 1rem;
  }

  /* Desktop breakpoint (>= 840px): show desktop nav, hide mobile elements */
  @media (min-width: 840px) {
    .header-container {
      justify-content: center;
      gap: 1.75rem;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.14em;
      text-transform: lowercase;
      white-space: nowrap;
      overflow-x: visible;
      flex-grow: 0;
    }

    .mobile-menu-btn,
    .mobile-menu-backdrop,
    .mobile-menu-drawer {
      display: none !important;
    }
  }

  @media (min-width: 1080px) {
    .header-container {
      gap: 2rem;
    }

    .header-nav {
      gap: 1.5rem;
      font-size: 0.875rem;
      letter-spacing: 0.16em;
    }
  }
</style>

<script>
  let cleanupMobileMenu: (() => void) | null = null

  function setupMobileMenu() {
    if (cleanupMobileMenu) {
      cleanupMobileMenu()
      cleanupMobileMenu = null
    }

    const headerWrapper = document.getElementById('header-wrapper')
    const toggleBtn = document.getElementById('mobile-menu-toggle')
    const drawer = document.getElementById('mobile-menu-drawer')
    const backdrop = document.getElementById('mobile-menu-backdrop')
    const openIcon = toggleBtn?.querySelector('.menu-icon-open')
    const closeIcon = toggleBtn?.querySelector('.menu-icon-close')
    const btnText = toggleBtn?.querySelector('.mobile-menu-btn-text')

    if (!toggleBtn || !drawer || !headerWrapper) return

    let isOpen = false

    function openMenu() {
      isOpen = true
      headerWrapper?.classList.add('is-open')
      drawer?.classList.add('is-open')
      if (backdrop) {
        backdrop.classList.remove('hidden')
        requestAnimationFrame(() => {
          backdrop.classList.add('is-open')
        })
      }
      toggleBtn?.classList.add('is-active')
      toggleBtn?.setAttribute('aria-expanded', 'true')
      openIcon?.classList.add('hidden')
      closeIcon?.classList.remove('hidden')
      if (btnText) btnText.textContent = 'close'
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      if (!isOpen) return
      isOpen = false
      headerWrapper?.classList.remove('is-open')
      drawer?.classList.remove('is-open')
      if (backdrop) {
        backdrop.classList.remove('is-open')
        setTimeout(() => {
          if (!isOpen) backdrop.classList.add('hidden')
        }, 200)
      }
      toggleBtn?.classList.remove('is-active')
      toggleBtn?.setAttribute('aria-expanded', 'false')
      openIcon?.classList.remove('hidden')
      closeIcon?.classList.add('hidden')
      if (btnText) btnText.textContent = 'menu'
      document.body.style.overflow = ''
    }

    function toggleMenu() {
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    }

    // Toggle button click
    toggleBtn.onclick = (e) => {
      e.stopPropagation()
      toggleMenu()
    }

    // Backdrop click closes cleanly
    if (backdrop) {
      backdrop.onclick = (e) => {
        e.stopPropagation()
        closeMenu()
      }
    }

    // Close on any mobile nav link click
    drawer.querySelectorAll('a').forEach((link) => {
      link.onclick = () => {
        closeMenu()
      }
    })

    // Close on Escape key
    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu()
      }
    }
    document.addEventListener('keydown', handleKeydown)

    // Close if screen is resized past desktop breakpoint (840px)
    const handleResize = () => {
      if (window.innerWidth >= 840 && isOpen) {
        closeMenu()
      }
    }
    window.addEventListener('resize', handleResize)

    cleanupMobileMenu = () => {
      closeMenu()
      document.body.style.overflow = ''
      document.removeEventListener('keydown', handleKeydown)
      window.removeEventListener('resize', handleResize)
    }
  }

  document.addEventListener('astro:page-load', setupMobileMenu)
  document.addEventListener('astro:before-swap', () => {
    if (cleanupMobileMenu) {
      cleanupMobileMenu()
      cleanupMobileMenu = null
    }
  })
</script>
