---
import Link from '@/components/Link.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'
---

<div>
  <div
    class="relative mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center gap-3 min-w-0 z-10">
      <Image src={logo} alt="Logo" class="size-5 shrink-0 sm:size-6" />
      <span
        class="hidden truncate text-lg leading-none font-medium min-[400px]:block"
        >{SITE.title}</span
      >
    </Link>
    <nav class="flex items-center gap-x-4 text-xs tracking-[0.14em] lowercase whitespace-nowrap overflow-x-auto flex-nowrap grow justify-start min-w-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:justify-center md:overflow-x-visible md:grow-0 md:shrink-0 md:gap-x-4 md:text-xs lg:gap-x-6 lg:text-sm lg:tracking-[0.16em]">
      {
        NAV_LINKS.map((item) => (
          <Link
            href={item.href}
            class="text-foreground/60 hover:text-foreground transition-colors"
          >
            {item.label}
          </Link>
        ))
      }
    </nav>
  </div>
</div>

<style>
  nav {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  nav::-webkit-scrollbar {
    display: none;  /* Chrome, Safari and Opera */
  }
</style>
