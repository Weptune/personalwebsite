---
import Link from '@/components/Link.astro'
import { ICON_MAP, NAV_LINKS, SITE, SOCIAL_LINKS } from '@/consts'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'

const currentPath = Astro.url.pathname

function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath.startsWith(href)
}

const NAV_ICONS: Record<string, string> = {
  '/albums': 'lucide:disc',
  '/movies': 'lucide:film',
  '/thoughts': 'lucide:library-big',
  '/maths': 'lucide:binary',
  '/research': 'lucide:flask-conical',
  '/projects': 'lucide:folder-kanban',
  '/guestbook': 'lucide:message-square',
  '/about': 'lucide:user',
}
---

<div class="header-wrapper">
  <div class="header-container">
    <Link href="/" class="header-logo">
      <Image src={logo} alt="Logo" class="size-5 shrink-0 sm:size-6" />
      <span class="truncate text-lg leading-none font-medium">
        {SITE.title}
      </span>
    </Link>

    <!-- Desktop nav (hidden on mobile, visible on >= 840px) -->
    <nav class="header-nav" aria-label="Main navigation">
      {
        NAV_LINKS.map((item) => {
          const active = isActive(item.href)
          return (
            <Link
              href={item.href}
              class:list={[
                'header-link transition-colors',
                active
                  ? 'text-foreground font-medium underline underline-offset-4 decoration-accent/60'
                  : 'text-foreground/60 hover:text-foreground',
              ]}
            >
              {item.label}
            </Link>
          )
        })
      }
    </nav>

    <!-- Mobile menu toggle button (visible on mobile, hidden on >= 840px) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="mobile-menu-btn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
    >
      <Icon name="lucide:menu" class="size-3.5 menu-icon-open" />
      <Icon name="lucide:x" class="size-3.5 menu-icon-close hidden" />
      <span class="mobile-menu-btn-text">menu</span>
    </button>
  </div>

  <!-- Mobile backdrop -->
  <div
    id="mobile-menu-backdrop"
    class="mobile-menu-backdrop"
    aria-hidden="true"
  ></div>

  <!-- Mobile drawer panel -->
  <div
    id="mobile-menu-drawer"
    class="mobile-menu-drawer"
    role="dialog"
    aria-label="Navigation menu"
    aria-modal="true"
  >
    <div class="mobile-menu-content">
      <div class="flex items-center justify-between mb-2 px-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
          navigation
        </span>
        <span class="text-[10px] font-mono text-muted-foreground/40">
          {NAV_LINKS.length} pages
        </span>
      </div>

      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {
          NAV_LINKS.map((item) => {
            const active = isActive(item.href)
            const iconName = NAV_ICONS[item.href] || 'lucide:link'
            return (
              <Link
                href={item.href}
                class:list={[
                  'mobile-nav-item flex items-center justify-between px-3 py-2 rounded-lg border transition-all text-xs font-mono tracking-wider lowercase',
                  active
                    ? 'border-primary/50 bg-primary/15 text-foreground font-semibold shadow-xs'
                    : 'border-border/30 bg-secondary/20 hover:bg-secondary/50 hover:border-border/60 text-foreground/80 hover:text-foreground',
                ]}
              >
                <div class="flex items-center gap-2.5">
                  <Icon
                    name={iconName}
                    class:list={[
                      'size-3.5 shrink-0',
                      active ? 'text-primary' : 'text-accent/80',
                    ]}
                  />
                  <span>{item.label}</span>
                </div>
                {active ? (
                  <span class="inline-flex items-center gap-1 text-[10px] text-primary/80 font-mono">
                    <span class="size-1.5 rounded-full bg-primary animate-pulse" />
                    <span>active</span>
                  </span>
                ) : (
                  <Icon
                    name="lucide:chevron-right"
                    class="size-3 text-muted-foreground/35"
                  />
                )}
              </Link>
            )
          })
        }
      </nav>

      <!-- Social links at the bottom of the drawer -->
      <div class="pt-3 mt-3 border-t border-border/30 flex items-center justify-between px-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
          connect
        </span>
        <div class="flex items-center gap-1.5">
          {
            SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="text-muted-foreground hover:text-foreground transition-colors p-1.5 rounded-md hover:bg-secondary/40"
              >
                <Icon name={ICON_MAP[social.label]} class="size-3.5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .header-wrapper {
    position: relative;
    width: 100%;
  }

  .header-container {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 0;
  }

  /* Desktop nav is hidden on mobile (< 840px) */
  .header-nav {
    display: none;
  }

  .header-link {
    display: inline-block;
    flex-shrink: 0;
  }

  /* Mobile menu button (< 840px) */
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--color-secondary, #222) 30%, transparent);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .mobile-menu-btn:hover {
    background-color: color-mix(in oklab, var(--color-secondary, #222) 60%, transparent);
    border-color: var(--color-border);
  }

  .mobile-menu-btn.is-active {
    border-color: var(--primary);
    background-color: color-mix(in oklab, var(--primary) 20%, transparent);
    color: var(--foreground);
  }

  /* Mobile backdrop */
  .mobile-menu-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .mobile-menu-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile drawer */
  .mobile-menu-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: color-mix(in oklab, var(--background) 95%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    max-height: calc(100dvh - 60px);
    overflow-y: auto;
  }

  .mobile-menu-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-content {
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    padding: 0.875rem 1rem 1rem;
  }

  /* Desktop breakpoint (>= 840px): show desktop nav, hide mobile elements */
  @media (min-width: 840px) {
    .header-container {
      justify-content: center;
      gap: 1.75rem;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.14em;
      text-transform: lowercase;
      white-space: nowrap;
      overflow-x: visible;
      flex-grow: 0;
    }

    .mobile-menu-btn,
    .mobile-menu-backdrop,
    .mobile-menu-drawer {
      display: none !important;
    }
  }

  @media (min-width: 1080px) {
    .header-container {
      gap: 2rem;
    }

    .header-nav {
      gap: 1.5rem;
      font-size: 0.875rem;
      letter-spacing: 0.16em;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle')
    const drawer = document.getElementById('mobile-menu-drawer')
    const backdrop = document.getElementById('mobile-menu-backdrop')
    const openIcon = toggleBtn?.querySelector('.menu-icon-open')
    const closeIcon = toggleBtn?.querySelector('.menu-icon-close')
    const btnText = toggleBtn?.querySelector('.mobile-menu-btn-text')

    if (!toggleBtn || !drawer || !backdrop) return

    let isOpen = false

    function openMenu() {
      isOpen = true
      drawer?.classList.add('is-open')
      backdrop?.classList.add('is-open')
      toggleBtn?.classList.add('is-active')
      toggleBtn?.setAttribute('aria-expanded', 'true')
      openIcon?.classList.add('hidden')
      closeIcon?.classList.remove('hidden')
      if (btnText) btnText.textContent = 'close'
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      isOpen = false
      drawer?.classList.remove('is-open')
      backdrop?.classList.remove('is-open')
      toggleBtn?.classList.remove('is-active')
      toggleBtn?.setAttribute('aria-expanded', 'false')
      openIcon?.classList.remove('hidden')
      closeIcon?.classList.add('hidden')
      if (btnText) btnText.textContent = 'menu'
      document.body.style.overflow = ''
    }

    function toggleMenu() {
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    }

    // Toggle button click
    toggleBtn.onclick = (e) => {
      e.stopPropagation()
      toggleMenu()
    }

    // Backdrop click closes
    backdrop.onclick = () => {
      if (isOpen) closeMenu()
    }

    // Close on any mobile nav link click
    drawer.querySelectorAll('a').forEach((link) => {
      link.onclick = () => {
        closeMenu()
      }
    })

    // Close on outside click
    const handleDocumentClick = (e: MouseEvent) => {
      if (!isOpen) return
      const target = e.target as HTMLElement
      if (!drawer.contains(target) && !toggleBtn.contains(target)) {
        closeMenu()
      }
    }
    document.addEventListener('click', handleDocumentClick)

    // Close on Escape key
    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu()
      }
    }
    document.addEventListener('keydown', handleKeydown)

    // Close if screen is resized past desktop breakpoint (840px)
    const handleResize = () => {
      if (window.innerWidth >= 840 && isOpen) {
        closeMenu()
      }
    }
    window.addEventListener('resize', handleResize)

    // Clean up on page navigation
    document.addEventListener(
      'astro:before-swap',
      () => {
        closeMenu()
        document.removeEventListener('click', handleDocumentClick)
        document.removeEventListener('keydown', handleKeydown)
        window.removeEventListener('resize', handleResize)
      },
      { once: true },
    )
  }

  setupMobileMenu()
  document.addEventListener('astro:page-load', setupMobileMenu)
</script>
