---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Search from '@/components/Search'
import Layout from '@/layouts/Layout.astro'
import { getProjectsByTag, getProjectsTags } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

export async function getStaticPaths() {
  const projectsTags = await getProjectsTags()
  return projectsTags.map(({ tag }) => ({
    params: { tag },
  }))
}

const { tag } = Astro.params as { tag: string }
const projects = await getProjectsByTag(tag)
const projectsTags = await getProjectsTags()

const projectsSearchData = projects.map((project) => ({
  id: project.id,
  title: project.data.name,
  url: project.data.link,
  description: project.data.description,
}))
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={`Projects tagged with #${tag}`}
    description={`Projects tagged with #${tag}.`}
  />
  <Breadcrumbs
    items={[
      { label: 'Projects', href: '/projects', icon: 'lucide:folder-kanban' },
      { label: `#${tag}`, icon: 'lucide:tag' },
    ]}
  />

  <div class="mb-8 flex flex-col gap-3">
    <Search
      client:load
      items={projectsSearchData}
      placeholder={`Search #${tag} projects...`}
    />
    {
      projectsTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-muted-foreground font-mono flex items-center gap-1 mr-1 text-[11px]">
            <Icon name="lucide:tags" class="size-3" />
            tags:
          </span>
          {projectsTags.map(({ tag: t, count }) => (
            <Link
              href={t === tag ? '/projects' : `/projects/tags/${t}`}
              class={
                t === tag
                  ? 'inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full border border-primary/60 bg-primary/20 text-foreground font-semibold ring-1 ring-primary/40 transition-all font-mono text-[11px]'
                  : 'inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full border border-border/40 bg-secondary/30 text-muted-foreground hover:text-foreground hover:border-accent/50 hover:bg-secondary/60 transition-all font-mono text-[11px]'
              }
            >
              <span class="text-accent/80 font-mono">#</span>
              <span>{t}</span>
              <span class="text-[10px] text-muted-foreground/60 ml-0.5">({count})</span>
            </Link>
          ))}
        </div>
      )
    }
  </div>

  <section class="flex flex-col gap-4 fade-in-up-soft">
    {
      projects.length === 0 ? (
        <p class="text-muted-foreground text-sm">
          No projects found tagged with #{tag}.
        </p>
      ) : (
        projects.map((project) => <ProjectCard project={project} />)
      )
    }
  </section>
</Layout>
