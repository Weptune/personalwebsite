---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section class="gothic-panel fade-in-up-soft p-6 sm:p-8 space-y-8">
    <!-- Hero & Bio -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl sm:text-3xl font-medium tracking-tight normal-case">hi <span class="font-mono font-normal text-primary/90 inline-block">:3</span> im abhinav</h2>
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono lowercase">
          <span class="rounded-full border border-rose-400/25 bg-rose-500/10 px-2.5 py-0.5 text-rose-300/90 transition-colors hover:border-rose-400/40 hover:bg-rose-500/15">feminist</span>
          <span class="rounded-full border border-violet-400/25 bg-violet-500/10 px-2.5 py-0.5 text-violet-300/90 transition-colors hover:border-violet-400/40 hover:bg-violet-500/15">bi</span>
          <span class="rounded-full border border-amber-300/25 bg-amber-400/10 px-2.5 py-0.5 text-amber-200/90 transition-colors hover:border-amber-300/40 hover:bg-amber-400/15">enby</span>
          <span class="rounded-full border border-cyan-400/25 bg-cyan-500/10 px-2.5 py-0.5 text-cyan-200/90 transition-colors hover:border-cyan-400/40 hover:bg-cyan-500/15">any prns</span>
        </div>
      </div>

      <p class="text-foreground/90 leading-relaxed text-base">
        im a 21 year old cs student with way too many interests. this website serves as a repository for everything that makes me myself.
      </p>

      <p class="text-muted-foreground leading-relaxed text-sm">
        it is usually common practice to separate your portfolio and personal sites, but for myself, i don't agree with that. i take pride in being passionate and open to learning about as many facets of the world as i can; they all play a part in shaping who i am, and what i believe in.
      </p>
    </div>

    <!-- Subtle gradient divider matching homepage -->
    <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-primary/25 to-transparent"></div>

    <!-- Topics Cloud -->
    <div class="space-y-3">
      <h3 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
        topics i enjoy & feel strongly about
      </h3>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/maths" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">math ↗</a>
        <a href="/projects" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">cs ↗</a>
        <a href="/research" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">ai & ml ↗</a>
        <a href="/tags/cryptography" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">cryptography ↗</a>
        <a href="/tags/politics" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">politics ↗</a>
        <a href="/albums" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">music ↗</a>
        <a href="/movies" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">cinema ↗</a>
        <a href="/thoughts" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">writing ↗</a>
        <a href="https://www.chess.com/member/weptunesworld" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20">chess ↗</a>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">reading</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">philosophy</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">minecraft</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">osu</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">fitness</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">fashion</span>
        <span class="inline-flex items-center rounded-full border border-border/40 bg-secondary/30 px-3 py-1 font-mono text-muted-foreground">tiny animals</span>
      </div>
    </div>

    <!-- Subtle gradient divider matching homepage -->
    <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-primary/25 to-transparent"></div>

    <!-- 2-Column: Lyrics Callout + Ramona -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center pt-1">
      <div class="border-l-2 border-primary/40 pl-5 font-serif italic text-sm text-foreground/80 leading-relaxed space-y-1.5">
        <p>Movie actors puzzled during combat</p>
        <p>Leading man just stutters when he talks</p>
        <p>There were teardrops on his contract</p>
        <p>But there was chicken to defrost</p>
        <p>Hiding in the pedals of amnesia</p>
        <p>Like a flower not in bloom</p>
        <p>You can act like you were swindled</p>
        <p>But I'll remind you of the truth</p>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/static/ramona.gif"
          alt="Ramona Flowers"
          class="rounded-xl object-contain max-h-56 opacity-95 transition-all duration-300 hover:opacity-100 hover:scale-[1.02] shadow-lg shadow-black/20"
          loading="eager"
        />
      </div>
    </div>
  </section>
</Layout>