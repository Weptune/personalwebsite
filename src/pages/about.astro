---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section class="fade-in-up-soft about-hero space-y-8 p-6 sm:p-8">
    <!-- Hero & Bio -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl sm:text-3xl font-medium tracking-tight normal-case">hi <span class="font-sans font-medium text-primary/90 inline-block">:3</span> im abhinav</h2>
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono lowercase">
          <!-- feminist -->
          <span class="identity-badge badge-feminist" title="feminist">
            <span class="feminist-symbol" aria-hidden="true">♀</span>
            <span>feminist</span>
          </span>

          <!-- bi -->
          <span class="identity-badge badge-bi" title="bisexual">
            <span class="flag-pin" aria-hidden="true">
              <span class="stripe-bi-pink"></span>
              <span class="stripe-bi-purple"></span>
              <span class="stripe-bi-blue"></span>
            </span>
            <span>bi</span>
          </span>

          <!-- enby (non-binary) -->
          <span class="identity-badge badge-enby" title="non-binary (enby)">
            <span class="flag-pin" aria-hidden="true">
              <span class="stripe-enby-yellow"></span>
              <span class="stripe-enby-white"></span>
              <span class="stripe-enby-purple"></span>
              <span class="stripe-enby-black"></span>
            </span>
            <span>enby</span>
          </span>

          <!-- any prns -->
          <span class="identity-badge badge-pronouns" title="any pronouns (they / he / she)">
            <span class="flag-pin flag-spectrum" aria-hidden="true"></span>
            <span>any prns</span>
          </span>
        </div>
      </div>

      <p class="text-foreground/90 leading-relaxed text-base">
        im a 21 year old cs student with way too many interests. this website serves as a repository for everything that makes me myself.
      </p>

      <p class="text-muted-foreground leading-relaxed text-sm">
        it is usually common practice to separate your portfolio and personal sites, but for myself, i don't agree with that. i take pride in being passionate and open to learning about as many facets of the world as i can; they all play a part in shaping who i am, and what i believe in.
      </p>
    </div>

    <!-- Subtle gradient divider matching homepage -->
    <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-primary/25 to-transparent"></div>

    <!-- Topics Cloud -->
    <div class="space-y-3">
      <h3 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
        topics i enjoy & feel strongly about
      </h3>
      <div class="space-y-2">
        <!-- Row 1: 8 topics -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-1 sm:gap-1.5 text-[11px] font-mono">
          <a href="/maths" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">math ↗</a>
          <a href="/projects" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">cs ↗</a>
          <a href="/research" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">ai & ml ↗</a>
          <a href="/tags/cryptography" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">cryptography ↗</a>
          <a href="/tags/politics" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">politics ↗</a>
          <a href="/albums" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">music ↗</a>
          <a href="/movies" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">cinema ↗</a>
          <a href="/thoughts" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">writing ↗</a>
        </div>
        <!-- Row 2: 8 topics -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-1 sm:gap-1.5 text-[11px] font-mono">
          <a href="https://www.chess.com/member/weptunesworld" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">chess ↗</a>
          <a href="/tags/literature" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">reading ↗</a>
          <a href="/tags/philosophy" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">philosophy ↗</a>
          <a href="/projects/minecraft-seed-generation" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">minecraft ↗</a>
          <a href="https://osu.ppy.sh/users/24049768" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">osu ↗</a>
          <a href="#" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">fitness ↗</a>
          <a href="/thoughts/vanity-in-fashion-culture" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">fashion ↗</a>
          <a href="#" class="inline-flex items-center gap-0.5 rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-foreground/90 transition-all hover:border-primary/60 hover:bg-primary/20 shrink-0">tiny animals ↗</a>
        </div>
      </div>
    </div>

    <!-- Subtle gradient divider matching homepage -->
    <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-primary/25 to-transparent"></div>

    <!-- 2-Column: Lyrics Callout + Ramona -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center pt-1">
      <div class="border-l-2 border-primary/40 pl-5 font-serif italic text-sm text-foreground/80 leading-relaxed space-y-1.5">
        <p>Movie actors puzzled during combat</p>
        <p>Leading man just stutters when he talks</p>
        <p>There were teardrops on his contract</p>
        <p>But there was chicken to defrost</p>
        <p>Hiding in the pedals of amnesia</p>
        <p>Like a flower not in bloom</p>
        <p>You can act like you were swindled</p>
        <p>But I'll remind you of the truth</p>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/static/ramona.gif"
          alt="Ramona Flowers"
          class="rounded-xl object-contain max-h-56 opacity-95 transition-all duration-300 hover:opacity-100 hover:scale-[1.02] shadow-lg shadow-black/20"
          loading="eager"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .identity-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: default;
    user-select: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .identity-badge:hover {
    transform: translateY(-1px) scale(1.03);
  }

  /* 1. Feminist */
  .badge-feminist {
    border: 1px solid rgba(251, 113, 133, 0.35);
    background: linear-gradient(135deg, rgba(244, 63, 94, 0.16) 0%, rgba(217, 70, 239, 0.12) 100%);
    color: #fecdd3;
  }
  .badge-feminist:hover {
    border-color: rgba(251, 113, 133, 0.7);
    color: #ffffff;
    box-shadow: 0 0 14px -1px rgba(244, 63, 94, 0.4);
  }
  .feminist-symbol {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.75rem;
    line-height: 1;
    color: #fb7185;
    user-select: none;
    transition: color 0.2s ease;
  }
  .badge-feminist:hover .feminist-symbol {
    color: #ffffff;
  }

  /* 2. Bisexual (Magenta / Purple / Royal Blue) */
  .badge-bi {
    border: 1px solid rgba(167, 139, 250, 0.35);
    background: linear-gradient(135deg, rgba(214, 2, 112, 0.16) 0%, rgba(155, 79, 150, 0.15) 50%, rgba(0, 56, 168, 0.18) 100%);
    color: #f5d0fe;
  }
  .badge-bi:hover {
    border-color: rgba(232, 121, 249, 0.7);
    color: #ffffff;
    box-shadow: 0 0 14px -1px rgba(214, 2, 112, 0.35), 0 0 14px -1px rgba(0, 56, 168, 0.3);
  }

  /* 3. Non-Binary / Enby (Yellow / White / Purple / Charcoal) */
  .badge-enby {
    border: 1px solid rgba(253, 224, 71, 0.35);
    background: linear-gradient(135deg, rgba(252, 244, 52, 0.14) 0%, rgba(255, 255, 255, 0.06) 30%, rgba(156, 92, 212, 0.18) 70%, rgba(44, 44, 44, 0.25) 100%);
    color: #fef08a;
  }
  .badge-enby:hover {
    border-color: rgba(253, 224, 71, 0.7);
    color: #ffffff;
    box-shadow: 0 0 14px -1px rgba(252, 244, 52, 0.3), 0 0 14px -1px rgba(156, 92, 212, 0.35);
  }

  /* 4. Any Pronouns (Spectrum / Prism) */
  .badge-pronouns {
    border: 1px solid rgba(56, 189, 248, 0.35);
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(168, 85, 247, 0.14) 50%, rgba(244, 114, 182, 0.15) 100%);
    color: #bae6fd;
  }
  .badge-pronouns:hover {
    border-color: rgba(56, 189, 248, 0.7);
    color: #ffffff;
    box-shadow: 0 0 14px -1px rgba(56, 189, 248, 0.35), 0 0 14px -1px rgba(244, 114, 182, 0.3);
  }

  /* Micro Pride Flag Pins */
  .flag-pin {
    display: inline-flex;
    flex-direction: column;
    width: 0.65rem;
    height: 0.45rem;
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    border: 0.5px solid rgba(255, 255, 255, 0.25);
  }

  /* Bi stripes: 40% Magenta (#d60270), 20% Purple (#9b4f96), 40% Blue (#0038a8) */
  .stripe-bi-pink {
    width: 100%;
    height: 40%;
    background-color: #d60270;
  }
  .stripe-bi-purple {
    width: 100%;
    height: 20%;
    background-color: #9b4f96;
  }
  .stripe-bi-blue {
    width: 100%;
    height: 40%;
    background-color: #0038a8;
  }

  /* Enby stripes: 25% Yellow (#fcf434), 25% White (#ffffff), 25% Purple (#9c5cd4), 25% Charcoal (#2c2c2c) */
  .stripe-enby-yellow {
    width: 100%;
    height: 25%;
    background-color: #fcf434;
  }
  .stripe-enby-white {
    width: 100%;
    height: 25%;
    background-color: #ffffff;
  }
  .stripe-enby-purple {
    width: 100%;
    height: 25%;
    background-color: #9c5cd4;
  }
  .stripe-enby-black {
    width: 100%;
    height: 25%;
    background-color: #2c2c2c;
  }

  /* Any pronouns spectrum gradient */
  .flag-spectrum {
    background: linear-gradient(135deg, #38bdf8 0%, #a855f7 50%, #f472b6 100%);
  }
</style>